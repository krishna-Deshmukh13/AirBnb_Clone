<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center py-5">
  <div class="col-12 col-md-8 col-lg-7">
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
      <!-- Form Header -->
      <div class="mb-4">
        <span class="badge bg-danger-subtle text-danger mb-2 px-3 py-2 rounded-pill fw-semibold">
          Host on Airbnb
        </span>
        <h2 class="fw-bold mb-1">Tell us about your place</h2>
        <p class="text-muted small">In this step, add the details that make your accommodation unique.</p>
      </div>

      <form action="/listings" method="POST" novalidate class="needs-validation">
        <!-- Title Input -->
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">Listing Title</label>
          <input
            type="text"
            name="listing[title]"
            id="title"
            placeholder="e.g. Luxurious Beachfront Villa with Infinity Pool"
            class="form-control form-control-lg rounded-3"
            required
          />
          <div class="invalid-feedback">Please provide a catchy listing title.</div>
        </div>

        <!-- Description Input -->
        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">Description</label>
          <textarea
            name="listing[description]"
            id="description"
            rows="4"
            placeholder="Describe what makes your space special, from amenities to scenic surroundings..."
            class="form-control rounded-3"
            required
          ></textarea>
          <div class="invalid-feedback">Please enter a description for guests.</div>
        </div>

        <!-- Image Link Input with Live Preview -->
        <div class="mb-3">
          <label for="image" class="form-label fw-semibold">Cover Image URL</label>
          <input
            type="url"
            name="listing[image]"
            id="imageInput"
            placeholder="https://images.unsplash.com/..."
            class="form-control rounded-3"
            oninput="previewListingImage(this.value)"
          />
          <div class="form-text">Paste a high-quality landscape image link (Unsplash, Cloudinary, etc.).</div>

          <!-- Live Image Preview Box -->
          <div id="imagePreviewContainer" class="mt-2 d-none">
            <img id="imagePreview" src="" alt="Preview" class="img-fluid rounded-3 border" style="max-height: 200px; width: 100%; object-fit: cover;" />
          </div>
        </div>

        <!-- Price & Country Row -->
        <div class="row g-3 mb-3">
          <div class="col-md-5">
            <label for="price" class="form-label fw-semibold">Price per night (&#8377; INR)</label>
            <div class="input-group">
              <span class="input-group-text bg-light fw-bold">&#8377;</span>
              <input
                type="number"
                name="listing[price]"
                id="price"
                placeholder="2500"
                min="100"
                class="form-control form-control-lg rounded-end-3"
                required
              />
              <div class="invalid-feedback">Please enter a valid price.</div>
            </div>
          </div>

          <div class="col-md-7">
            <label for="country" class="form-label fw-semibold">Country</label>
            <input
              type="text"
              name="listing[country]"
              id="country"
              placeholder="e.g. India, Italy, Switzerland"
              class="form-control form-control-lg rounded-3"
              required
            />
            <div class="invalid-feedback">Please enter the country.</div>
          </div>
        </div>

        <!-- Location / City -->
        <div class="mb-4">
          <label for="location" class="form-label fw-semibold">Location / City</label>
          <input
            type="text"
            name="listing[location]"
            id="location"
            placeholder="e.g. Goa, Manali, Mumbai, Florence"
            class="form-control form-control-lg rounded-3"
            required
          />
          <div class="invalid-feedback">Please enter the city or location.</div>
        </div>

        <!-- Submit & Cancel -->
        <div class="d-flex align-items-center justify-content-between pt-2">
          <a href="/listings" class="btn btn-link text-muted text-decoration-none">Cancel</a>
          <button type="submit" class="btn btn-airbnb-gradient px-4 py-2 rounded-pill fw-semibold fs-6">
            Publish Listing
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
