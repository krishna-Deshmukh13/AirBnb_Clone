<% layout("/layouts/boilerplate") %>

<div class="show-page-wrapper py-4">
  <!-- Listing Header -->
  <div class="listing-header mb-3">
    <h1 class="listing-title-heading fw-bold mb-2"><%= listing.title %></h1>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 text-muted small">
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="fw-semibold text-dark"><i class="fa-solid fa-star text-dark"></i> 4.96</span>
        <span>&middot;</span>
        <a href="#reviews-section" class="text-dark fw-semibold text-decoration-underline">
          <%= listing.reviews ? listing.reviews.length : 0 %> reviews
        </a>
        <span>&middot;</span>
        <span class="badge bg-light text-dark border">Superhost</span>
        <span>&middot;</span>
        <span class="text-decoration-underline text-dark"><%= listing.location %>, <%= listing.country %></span>
      </div>

      <div class="d-flex align-items-center gap-3">
        <button class="btn btn-sm btn-light border-0 d-flex align-items-center gap-2" onclick="navigator.clipboard.writeText(window.location.href); alert('Listing link copied to clipboard!');">
          <i class="fa-regular fa-share-from-square"></i>
          <span class="text-decoration-underline fw-semibold">Share</span>
        </button>
        <button class="btn btn-sm btn-light border-0 d-flex align-items-center gap-2" onclick="toggleWishlist(event, this)">
          <i class="fa-regular fa-heart"></i>
          <span class="text-decoration-underline fw-semibold">Save</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Hero Image Showcase -->
  <div class="show-hero-container mb-4">
    <img
      src="<%= listing.image.url %>"
      class="show-hero-img w-100"
      alt="<%= listing.title %>"
      onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80';"
    />
  </div>

  <!-- Two Column Content Layout -->
  <div class="row g-5">
    <!-- Left Details Column (7 cols) -->
    <div class="col-lg-7">
      <!-- Host & Space Info -->
      <div class="host-info-bar pb-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
          <h4 class="fw-bold mb-1">Entire villa in <%= listing.location %>, <%= listing.country %></h4>
          <p class="text-muted mb-0">6 guests &middot; 3 bedrooms &middot; 3 beds &middot; 2.5 baths</p>
        </div>
        <div class="host-avatar-circle">
          <i class="fa-solid fa-user-tie"></i>
        </div>
      </div>

      <!-- Key Highlights -->
      <div class="stay-highlights py-4 border-bottom">
        <div class="d-flex gap-3 mb-3">
          <i class="fa-solid fa-laptop-code fs-4 text-secondary mt-1"></i>
          <div>
            <div class="fw-bold">Dedicated workspace</div>
            <div class="text-muted small">A private room with high-speed wifi, well-suited for working remotely.</div>
          </div>
        </div>
        <div class="d-flex gap-3 mb-3">
          <i class="fa-solid fa-key fs-4 text-secondary mt-1"></i>
          <div>
            <div class="fw-bold">Self check-in</div>
            <div class="text-muted small">Check yourself in effortlessly with the smart keypad lock.</div>
          </div>
        </div>
        <div class="d-flex gap-3 mb-3">
          <i class="fa-solid fa-location-dot fs-4 text-secondary mt-1"></i>
          <div>
            <div class="fw-bold">Great location</div>
            <div class="text-muted small">95% of recent guests gave the location a 5-star rating.</div>
          </div>
        </div>
        <div class="d-flex gap-3">
          <i class="fa-solid fa-calendar-check fs-4 text-secondary mt-1"></i>
          <div>
            <div class="fw-bold">Free cancellation for 48 hours</div>
            <div class="text-muted small">Get a full refund if your travel plans change.</div>
          </div>
        </div>
      </div>

      <!-- AirCover Guarantee -->
      <div class="aircover-banner py-4 border-bottom">
        <div class="aircover-title fs-3 fw-bold mb-2">
          <span class="text-danger">air</span><span class="text-dark">cover</span>
        </div>
        <p class="text-muted small mb-2">
          Every booking includes free protection from Host cancellations, listing inaccuracies, and other issues like trouble checking in.
        </p>
        <a href="#aircover" class="fw-semibold text-dark text-decoration-underline small">Learn more</a>
      </div>

      <!-- Description -->
      <div class="listing-description-box py-4 border-bottom">
        <h5 class="fw-bold mb-3">About this space</h5>
        <p class="lead-text text-secondary mb-0" style="line-height: 1.7;">
          <%= listing.description %>
        </p>
      </div>

      <!-- What this place offers (Amenities) -->
      <div class="amenities-box py-4 border-bottom">
        <h5 class="fw-bold mb-3">What this place offers</h5>
        <div class="row row-cols-2 g-3">
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-mountain-sun fs-5 text-secondary"></i>
            <span>Scenic mountain & garden views</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-wifi fs-5 text-secondary"></i>
            <span>Fast Wi-Fi &ndash; 250 Mbps</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-person-swimming fs-5 text-secondary"></i>
            <span>Private outdoor pool</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-square-parking fs-5 text-secondary"></i>
            <span>Free parking on premises</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-utensils fs-5 text-secondary"></i>
            <span>Fully equipped chef's kitchen</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-snowflake fs-5 text-secondary"></i>
            <span>Central air conditioning</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-tv fs-5 text-secondary"></i>
            <span>65" 4K HDTV with Netflix</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-shield-halved fs-5 text-secondary"></i>
            <span>Smoke and carbon monoxide alarm</span>
          </div>
        </div>
      </div>

      <!-- Reviews Section -->
      <div class="reviews-section py-4" id="reviews-section">
        <div class="d-flex align-items-center gap-2 mb-4">
          <h4 class="fw-bold mb-0">
            <i class="fa-solid fa-star text-dark small"></i>
            4.96 &middot; <%= listing.reviews ? listing.reviews.length : 0 %> reviews
          </h4>
        </div>

        <!-- Rating Sub-metrics Breakdown -->
        <div class="row row-cols-2 g-3 mb-4 rating-bars-box pb-3 border-bottom">
          <div class="col">
            <div class="d-flex justify-content-between align-items-center mb-1 small fw-semibold">
              <span>Cleanliness</span>
              <span>4.9</span>
            </div>
            <div class="progress" style="height: 4px;">
              <div class="progress-bar bg-dark" style="width: 98%;"></div>
            </div>
          </div>
          <div class="col">
            <div class="d-flex justify-content-between align-items-center mb-1 small fw-semibold">
              <span>Accuracy</span>
              <span>5.0</span>
            </div>
            <div class="progress" style="height: 4px;">
              <div class="progress-bar bg-dark" style="width: 100%;"></div>
            </div>
          </div>
          <div class="col">
            <div class="d-flex justify-content-between align-items-center mb-1 small fw-semibold">
              <span>Communication</span>
              <span>4.9</span>
            </div>
            <div class="progress" style="height: 4px;">
              <div class="progress-bar bg-dark" style="width: 98%;"></div>
            </div>
          </div>
          <div class="col">
            <div class="d-flex justify-content-between align-items-center mb-1 small fw-semibold">
              <span>Location</span>
              <span>4.9</span>
            </div>
            <div class="progress" style="height: 4px;">
              <div class="progress-bar bg-dark" style="width: 98%;"></div>
            </div>
          </div>
        </div>

        <!-- Existing Reviews List -->
        <% if (listing.reviews && listing.reviews.length > 0) { %>
          <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
            <% for(let review of listing.reviews) { %>
              <div class="col">
                <div class="card h-100 border-0 p-3 bg-light rounded-4">
                  <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="avatar-circle-sm">
                      <i class="fa-solid fa-circle-user text-secondary fs-3"></i>
                    </div>
                    <div>
                      <h6 class="fw-bold mb-0"><%= review.author || 'Guest Traveler' %></h6>
                      <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %></small>
                    </div>
                  </div>
                  <div class="review-stars text-warning small mb-2">
                    <% for(let s = 1; s <= 5; s++) { %>
                      <i class="fa-<%= s <= review.rating ? 'solid' : 'regular' %> fa-star"></i>
                    <% } %>
                  </div>
                  <p class="review-text text-secondary mb-0 small" style="line-height: 1.6;">
                    <%= review.comment %>
                  </p>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>

        <!-- Leave a Review Form -->
        <div class="card border rounded-4 p-4 shadow-sm bg-white mt-4">
          <h5 class="fw-bold mb-3">Leave a Review</h5>
          <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3">
              <label for="rating" class="form-label fw-semibold small">Rating</label>
              <div class="d-flex align-items-center gap-3">
                <input
                  type="range"
                  min="1"
                  max="5"
                  value="5"
                  id="rating"
                  name="review[rating]"
                  class="form-range"
                  style="max-width: 250px;"
                  oninput="document.getElementById('ratingVal').innerText = this.value + ' / 5 ★'"
                />
                <span id="ratingVal" class="fw-bold text-danger">5 / 5 ★</span>
              </div>
            </div>

            <div class="mb-3">
              <label for="comment" class="form-label fw-semibold small">Comments & Experience</label>
              <textarea
                name="review[comment]"
                id="comment"
                cols="30"
                rows="4"
                class="form-control rounded-3"
                placeholder="Share your experience staying at this place..."
                required
              ></textarea>
              <div class="invalid-feedback">Please share some feedback in your comment.</div>
            </div>

            <button type="submit" class="btn btn-airbnb-gradient rounded-pill px-4 fw-semibold">
              Submit Review
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Right Reservation & Host Actions Column (5 cols) -->
    <div class="col-lg-5 col-xl-4 offset-xl-1">
      <div class="sticky-top" style="top: 100px; z-index: 10;">
        <!-- Airbnb Reservation Card -->
        <div class="reservation-card card border shadow-lg rounded-4 p-4 mb-4 bg-white">
          <div class="d-flex justify-content-between align-items-baseline mb-3">
            <div>
              <span class="fs-3 fw-bold">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %></span>
              <span class="text-secondary"> / night</span>
            </div>
            <div class="small fw-semibold">
              <i class="fa-solid fa-star text-dark small"></i> 4.96
              <span class="text-muted fw-normal"> &middot; <%= listing.reviews ? listing.reviews.length : 0 %> reviews</span>
            </div>
          </div>

          <!-- Date & Guest Selector Box -->
          <div class="booking-picker-box border rounded-3 mb-3 overflow-hidden">
            <div class="row g-0 border-bottom">
              <div class="col-6 p-2 border-end">
                <label class="d-block small text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Check-in</label>
                <div class="fw-semibold small">24/11/2026</div>
              </div>
              <div class="col-6 p-2">
                <label class="d-block small text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Checkout</label>
                <div class="fw-semibold small">29/11/2026</div>
              </div>
            </div>
            <div class="p-2">
              <label class="d-block small text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Guests</label>
              <div class="fw-semibold small">2 guests</div>
            </div>
          </div>

          <!-- Reserve Button -->
          <button type="button" class="btn btn-airbnb-gradient w-100 py-3 fw-bold fs-6 rounded-3 mb-2" onclick="alert('Reservation request simulated! This is a demo project.')">
            Reserve
          </button>
          <p class="text-center text-muted small mb-3">You won't be charged yet</p>

          <!-- Price Calculation Breakdown -->
          <div class="pricing-breakdown small text-secondary">
            <div class="d-flex justify-content-between mb-2">
              <span class="text-decoration-underline">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %> &times; 5 nights</span>
              <span>&#8377;<%= listing.price ? (listing.price * 5).toLocaleString("en-IN") : '0' %></span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-decoration-underline">Cleaning fee</span>
              <span>&#8377;500</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-decoration-underline">Airbnb service fee</span>
              <span>&#8377;750</span>
            </div>
            <hr class="my-3" />
            <div class="d-flex justify-content-between fw-bold text-dark fs-6">
              <span>Total before taxes</span>
              <span>&#8377;<%= listing.price ? (listing.price * 5 + 1250).toLocaleString("en-IN") : '1,250' %></span>
            </div>
          </div>
        </div>

        <!-- Host Administrative Controls -->
        <div class="card border rounded-4 p-3 bg-light">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold small text-muted">Host Actions</span>
            <span class="badge bg-secondary">Owner Mode</span>
          </div>
          <div class="d-flex gap-2">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark btn-sm flex-grow-1 rounded-pill">
              <i class="fa-regular fa-pen-to-square me-1"></i> Edit Listing
            </a>
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="m-0" onsubmit="return confirm('Are you sure you want to delete this listing?');">
              <button class="btn btn-outline-danger btn-sm rounded-pill px-3">
                <i class="fa-regular fa-trash-can me-1"></i> Delete
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
